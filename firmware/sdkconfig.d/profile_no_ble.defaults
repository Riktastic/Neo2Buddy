# Full portal/features without Bluetooth HID.
# CONFIG_SUPPORT_BLE is not set
CONFIG_SUPPORT_WIFI_WEB=y
CONFIG_SUPPORT_STOCK_APPLETS=y
CONFIG_SUPPORT_OLED=y
CONFIG_SUPPORT_SDCARD=y
CONFIG_SUPPORT_BATTERY=y
CONFIG_BUDDY_UART_CMD=y

# CONFIG_BT_ENABLED is not set
# CONFIG_BT_CONTROLLER_ENABLED is not set
# CONFIG_BT_NIMBLE_ENABLED is not set
